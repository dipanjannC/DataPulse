# ──────────────────────────────────────────────────────────────────────────────
# Environment variables template
#
# Setup:
#   cp .env.sample .env          # or: copy .env.sample .env  (Windows cmd)
#   # Then open .env and replace placeholder values with real credentials.
#
# .env is git-ignored — never commit it.
# ──────────────────────────────────────────────────────────────────────────────

# Google API key for Gemini (also used by google-adk)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Route google-adk through the Gemini Developer API (not Vertex AI).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional override; defaults to gemini-flash-latest in src/shared/config.py
GEMINI_MODEL=gemini-flash-latest

# Neo4j Aura connection.
# From your Aura instance: copy the "Connection URI" (it looks like neo4j+s://<dbid>.databases.neo4j.io)
# and the generated password.
NEO4J_URI=neo4j+s://your_dbid.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_password_here
